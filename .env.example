# ---------------------------------------------------------------------------
# 5SE™ Packaging Intelligence — environment
# The app runs fully in mock mode without any key. Never commit a real .env.
# ---------------------------------------------------------------------------

# true  → mock attention data, rule-based 5SE engine, simulated optimized design (default)
# false → real providers; falls back to mock automatically if the provider key is missing
USE_MOCK_DATA=true

# Attention provider: attention_insight (preferred) | feng_gui | mock
ATTENTION_PROVIDER=attention_insight
ATTENTION_INSIGHT_API_KEY=
ATTENTION_INSIGHT_BASE_URL=https://ext-api.attentioninsight.com/api/v2

# OpenAI — structured 5SE analysis (Responses API, store=false) and single optimized design
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium

# Optional secondary provider
FENG_GUI_API_KEY=
FENG_GUI_SERVICE_URL=https://service.feng-gui.com
FENG_GUI_USERNAME=

# Preview-only (leave empty on Vercel)
# NEXT_PUBLIC_STATIC_PREVIEW=1
# NEXT_PUBLIC_API_BASE=
