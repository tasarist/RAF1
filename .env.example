# v0.1 works without API keys because mock mode is enabled by default.
USE_MOCK_DATA=true

# Set USE_MOCK_DATA=false only after Feng-GUI grants the api role for this account.
FENG_GUI_API_KEY=
FENG_GUI_SERVICE_URL=https://service.feng-gui.com
FENG_GUI_USERNAME=

# Optional: enrich Feng-GUI output with GPT-powered 5SE diagnosis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium

# ── Pack Analytic 5SE™ demo (motor v4) ──
# YZ görsel okuma modeli (erişim yoksa gpt-4.1'e düşer) ve görsel üretim modeli (yoksa gpt-image-1).
OPENAI_VISION_MODEL=gpt-5.4
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Kayıt klasörü. Vercel'de varsayılan /tmp/pack-analytic (geçici; yeniden başlatmada silinir).
# DATA_DIR=./data
# Yalnızca geliştirme: YZ'ye çıkmadan örnek okuma döndürür.
# AI_MOCK=1
